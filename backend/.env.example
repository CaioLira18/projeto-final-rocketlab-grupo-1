# Configurações dos Bancos de Dados (Silver & Gold)
DATABASE_URL_SILVER=sqlite:///./bd/app_silver.db
DATABASE_URL_GOLD=sqlite:///./bd/app_gold.db

# Configurações da Aplicação
ENVIRONMENT=development

# ==============================================================================
# CONFIGURAÇÕES DE INTEGRAÇÃO COM O DATABRICKS (VIA DE MÃO DUPLA)
# ==============================================================================

# 1. URL do seu Workspace do Databricks.
# Copie do navegador até o final do domínio (.com). Remova qualquer barra (/) no final!
# Exemplo: https://dbc-f7b0f69a-fa4c.cloud.databricks.com ou https://adb-123456789.azuredatabricks.net
DATABRICKS_HOST=https://seu-workspace.cloud.databricks.com

# 2. Token de Acesso Pessoal (Personal Access Token - PAT).
# No Databricks, vá em: User Settings (canto superior direito) -> Developer -> Access Tokens -> Generate new token
# Copie a chave (que começa tipicamente com 'dapi') e cole aqui por completo:
DATABRICKS_TOKEN=dapi...seu_token_aqui...

# 3. Caminho de Ingestão (Landing Zone) no Unity Catalog Volumes.
DATABRICKS_DEST_DIR=/Volumes/stack_overgol/default/landing/

# 4. Caminho dos Arquivos Refinados (Gold Zone) no Unity Catalog Volumes.
DATABRICKS_GOLD_DIR=/Volumes/stack_overgol/default/gold/


# Chave da API do Google AI Studio (Gemini), usada pelo agente de IA.
# Obtenha em https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# (Opcional) Caminho customizado para o banco Gold lido pelo agente
# GOLD_DB_PATH=/caminho/absoluto/para/app_gold.db
