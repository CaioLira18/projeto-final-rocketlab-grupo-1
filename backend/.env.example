# Configurações dos Bancos de Dados (Silver & Gold)
DATABASE_URL_SILVER=sqlite:///./bd/app_silver.db
DATABASE_URL_GOLD=sqlite:///./bd/app_gold.db

# Configurações da Aplicação
ENVIRONMENT=development

# Configurações Databricks CLI
DATABRICKS_HOST=https://seu-workspace.cloud.databricks.com/
DATABRICKS_TOKEN=dapi...seu_token_aqui...
DATABRICKS_DEST_DIR=dbfs:/Volumes/stack_overgol/default/landing/
DATABRICKS_GOLD_DIR=dbfs:/Volumes/stack_overgol/default/gold_exports/

# Chave da API do Google AI Studio (Gemini), usada pelo agente de IA.
# Obtenha em https://aistudio.google.com/apikey
# Também pode ser definida em ai-agent/.env — qualquer um dos dois é lido em runtime.
GEMINI_API_KEY=your_gemini_api_key_here
